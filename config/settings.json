{
  "permissions": {
    "allow": [
      "mcp__claude_ai_Netlify__netlify-deploy-services-updater"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/sync-config-repo.sh || true",
            "statusMessage": "Sincronizando config/ com claude-code-setup..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/sync-config-repo.sh || true",
            "statusMessage": "Verificando sincronização de config/packages..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/sync-memory-repo.sh 2>/dev/null || true",
            "statusMessage": "Sincronizando memória com claude-code-setup..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/sync-config-repo.sh || true",
            "statusMessage": "Verificando pacotes instalados..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "language": "pt-BR",
  "voice": {
    "enabled": true,
    "mode": "tap",
    "autoSubmit": true
  },
  "theme": "auto",
  "switchModelsOnFlag": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "mcp__claude_ai_Netlify__netlify-deploy-services-updater"
    ]
  }
}
