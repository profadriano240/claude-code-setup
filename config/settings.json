{
  "language": "pt-BR",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "auto",
  "voiceEnabled": true,
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/adriano/.claude/hooks/sync-config-repo.sh 2>/dev/null || true",
            "statusMessage": "Sincronizando config/ com claude-code-setup..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/adriano/.claude/hooks/sync-config-repo.sh 2>/dev/null || true",
            "statusMessage": "Verificando sincronização de config/packages..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/adriano/.claude/hooks/tts-response.sh 2>/dev/null || true",
            "statusMessage": "Lendo resposta em voz alta...",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/adriano/.claude/hooks/sync-memory-repo.sh 2>/dev/null || true",
            "statusMessage": "Sincronizando memória com claude-code-setup..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/adriano/.claude/hooks/sync-config-repo.sh 2>/dev/null || true",
            "statusMessage": "Verificando pacotes instalados..."
          }
        ]
      }
    ]
  }
}
